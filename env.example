# 企业微信机器人 Webhook 地址
# 复制为 .env 后，把下面的 YOUR_KEY_HERE 换成自己的机器人 key；不使用通知可留空
NADO_VARIATIONAL_WECHAT_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR_KEY_HERE

# 扫描间隔（秒），用于后台行情刷新
ARBITRAGE_SCAN_INTERVAL=10

# 微信通知冷却时间（秒），默认 1800，即 30 分钟一次
NOTIFICATION_COOLDOWN_SECONDS=1800

# 通知时间窗口设置：只在每个整点后的指定分钟开始发送通知
# 避免费率结算期间的波动干扰
# 0=不限制；10=从 XX:10 到 XX:59 可以发送
NOTIFY_MINUTE_OFFSET=10

# 过滤低流动性的交易对（单位 USD），默认 20w
GLOBAL_MIN_VOLUME_USD=200000

# 最大价格偏差容忍度（百分比），用于拦截同名假币；15.0 表示 15%
MAX_PRICE_DEVIATION_PCT=15.0

# 交易所基础接口地址
NADO_BASE_URL=https://archive.test.nado.xyz
VARIATIONAL_BASE_URL=https://omni.variational.io

# Variational 浏览器模拟请求配置
VARIATIONAL_USER_AGENT=Mozilla/5.0
VARIATIONAL_COOKIE=

# 交易成本假设（单位：基点 bps）
NADO_TAKER_FEE_BPS=3.5
VARIATIONAL_TAKER_FEE_BPS=0.0
DEFAULT_SLIPPAGE_BPS=10.0

# === 面板显示阈值（Dashboard）===
# 当前面板会展示所有可计算路线；这些阈值主要用于标记是否达到原始机会标准
DASHBOARD_MIN_SPREAD_BPS=20
DASHBOARD_MIN_FUNDING_BPS=10
DASHBOARD_MIN_TOTAL_BPS=20

# 反向价差机会的最大资金费覆盖时间（小时）
# 价差不利但资金费优势能在该时间内覆盖时，用于标记资金费覆盖型机会
DASHBOARD_MAX_COVER_HOURS=24

# === 微信推送阈值（Notify）===
# 微信推送仍然会按下面条件过滤，避免页面全量展示后通知过多
NOTIFY_MIN_SPREAD_BPS=100
NOTIFY_MIN_FUNDING_BPS=50
NOTIFY_MIN_TOTAL_BPS=100

# 反向价差机会的最大资金费覆盖时间（小时）
# 价差不利但资金费优势能在该时间内覆盖时，才允许推送
NOTIFY_MAX_COVER_HOURS=24

# === 风险管理配置 ===
# 资金费反转时间阈值（分钟）：资金费率持续不利超过该时间才触发退出警报
FUNDING_REVERSAL_THRESHOLD_MINUTES=5

# 平仓警告阈值（基点）：当净资金费率低于该值时触发退出警报
# 建议设置为负值，例如 -33.3 表示 8h 亏损 33.3 bps，约等于每天亏损 1%
EXIT_MIN_NET_FUNDING_BPS=-33.3

# HTTP 请求超时设置（秒）
NADO_HTTP_TIMEOUT=10.0
VARIATIONAL_HTTP_TIMEOUT=10.0
BINANCE_HTTP_TIMEOUT=10.0
HYPERLIQUID_HTTP_TIMEOUT=10.0

# 可选：指定监控的交易对，多个用英文逗号分隔，例如 BTCUSDT,ETHUSDT
# 留空则程序自动寻找各交易所共有币种
TRACKED_SYMBOLS=

# 黑名单：全局屏蔽指定交易对，不显示在面板，也不推送通知
# 多个用英文逗号分隔，例如 CRCL,TEST
BLACKLIST_SYMBOLS=

# 可选：企业微信通知交易所白名单，多个用英文逗号分隔
# 只有涉及白名单交易所的套利机会才会触发微信通知；留空则通知所有交易所
NOTIFICATION_EXCHANGES=

# === 持仓管理认证 ===
# 首次启动并且数据库没有用户时，会自动创建这个管理员账号
POSITION_USER=admin
POSITION_PASS=change-me

# 多用户持仓管理 SQLite 数据库路径
# 默认放在项目 data 目录；迁移和备份时重点关注这个文件
ARBITRAGE_DB_PATH=data/arbitrage.db

# var-arbitrage example environment file
# Copy this file to .env, then edit values for your server.
# On Linux, if the file was edited on Windows, run: sed -i 's/\r$//' .env

# ----------------------------------------------------------------------
# WeCom / notification
# ----------------------------------------------------------------------
# Enterprise WeChat robot webhook. Leave empty to disable global alerts.
NADO_VARIATIONAL_WECHAT_WEBHOOK=

# Notification cooldown in seconds. Default: 1800 = 30 minutes.
NOTIFICATION_COOLDOWN_SECONDS=1800

# Start sending notifications after N minutes past each hour.
# 0 = no time-window limit; 10 = from XX:10 to XX:59.
NOTIFY_MINUTE_OFFSET=10

# Optional comma-separated exchange allowlist for notifications.
# Empty means all exchanges can notify.
NOTIFICATION_EXCHANGES=

# ----------------------------------------------------------------------
# Scan / symbols
# ----------------------------------------------------------------------
# Scan interval in seconds. Lower value updates faster but increases API usage.
ARBITRAGE_SCAN_INTERVAL=180

# Optional comma-separated symbols. Empty means auto-discover common markets.
# Example: BTCUSDT,ETHUSDT,SOLUSDT
TRACKED_SYMBOLS=

# Optional comma-separated blacklist. Matches substrings such as CRCL or TEST.
BLACKLIST_SYMBOLS=

# ----------------------------------------------------------------------
# Dashboard display thresholds
# Dashboard now displays every calculable route, but these values are kept
# as metadata to mark whether a route meets the original dashboard threshold.
# ----------------------------------------------------------------------
DASHBOARD_MIN_SPREAD_BPS=20
DASHBOARD_MIN_FUNDING_BPS=10
DASHBOARD_MIN_TOTAL_BPS=20
DASHBOARD_MAX_COVER_HOURS=24

# ----------------------------------------------------------------------
# WeCom notification thresholds
# These still control whether an alert is pushed to WeChat.
# ----------------------------------------------------------------------
NOTIFY_MIN_SPREAD_BPS=100
NOTIFY_MIN_FUNDING_BPS=50
NOTIFY_MIN_TOTAL_BPS=100
NOTIFY_MAX_COVER_HOURS=24

# ----------------------------------------------------------------------
# Position / exit alert settings
# ----------------------------------------------------------------------
# Default admin account created only when the SQLite users table is empty.
POSITION_USER=admin
POSITION_PASS=change-me

# SQLite database path for multi-user positions.
ARBITRAGE_DB_PATH=data/arbitrage.db

# Funding must stay unfavorable for this many minutes before exit alert.
FUNDING_REVERSAL_THRESHOLD_MINUTES=5

# Exit alert threshold in bps on the base interval.
# -33.3 bps per 8h roughly equals -1% per day.
EXIT_MIN_NET_FUNDING_BPS=-33.3

# ----------------------------------------------------------------------
# Safety / liquidity filters
# ----------------------------------------------------------------------
# Minimum 24h volume in USD. Low-volume pairs are hidden.
GLOBAL_MIN_VOLUME_USD=200000

# Maximum price deviation percent between same-symbol markets.
# Used to block same-name but different-token markets.
MAX_PRICE_DEVIATION_PCT=15.0

# Legacy thresholds kept for compatibility with old scripts.
MIN_SPREAD_BPS=100
MIN_FUNDING_BPS=80

# ----------------------------------------------------------------------
# Fee / slippage assumptions, in bps
# ----------------------------------------------------------------------
DEFAULT_SLIPPAGE_BPS=10.0
NADO_TAKER_FEE_BPS=3.5
VARIATIONAL_TAKER_FEE_BPS=0.0
HYPERLIQUID_TAKER_FEE_BPS=4.5

# ----------------------------------------------------------------------
# Exchange endpoints and timeouts
# Usually keep these defaults unless an exchange API endpoint changes.
# ----------------------------------------------------------------------
NADO_BASE_URL=https://archive.test.nado.xyz
NADO_HTTP_TIMEOUT=10.0

VARIATIONAL_BASE_URL=https://omni.variational.io
VARIATIONAL_HTTP_TIMEOUT=10.0
VARIATIONAL_SCRAPE_MODE=scrape
VARIATIONAL_USER_AGENT=Mozilla/5.0
VARIATIONAL_COOKIE=

BINANCE_BASE_URL=https://fapi.binance.com
BINANCE_HTTP_TIMEOUT=10.0

LIGHTER_BASE_URL=https://mainnet.zklighter.elliot.ai
LIGHTER_HTTP_TIMEOUT=10.0

HYPERLIQUID_BASE_URL=https://api.hyperliquid.xyz
HYPERLIQUID_HTTP_TIMEOUT=10.0

EDGEX_BASE_URL=https://pro.edgex.exchange
EDGEX_HTTP_TIMEOUT=10.0
EDGEX_MIN_VOLUME_USD=100000

BACKPACK_BASE_URL=https://api.backpack.exchange
BACKPACK_HTTP_TIMEOUT=10.0

GRVT_BASE_URL=https://market-data.grvt.io
GRVT_HTTP_TIMEOUT=10.0
